generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES_EXECUTIVE
  USER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  password     String
  phone        String?
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resetToken   String? 
  resetExpires DateTime?

  teams        Team[]    @relation("TeamUsers")
  leads        Lead[]    @relation("LeadOwner")
  activities   Activity[]
  histories    LeadHistory[] @relation("UserLeadHistory")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[] @relation("TeamUsers")
  leads Lead[]
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  email       String?
  phone       String?
  company     String?
  status      String     @default("NEW")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  ownerId String
  owner   User       @relation("LeadOwner", fields: [ownerId], references: [id])
  teamId  String?
  team    Team?      @relation(fields: [teamId], references: [id])
  activities Activity[]
  histories  LeadHistory[]
}

model Activity {
  id        String   @id @default(uuid())
  type      String
  content   String?
  createdAt DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model LeadHistory {
  id         String   @id @default(uuid())
  leadId     String
  changedBy  String
  changeType String
  changeData Json
  createdAt  DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id])
  user   User @relation("UserLeadHistory", fields: [changedBy], references: [id])
}
